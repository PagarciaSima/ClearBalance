<?xml version="1.0" encoding="UTF-8"?>
<jasperReport
	xmlns="http://jasperreports.sourceforge.net/jasperreports"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
	name="invoice_simple" pageWidth="595" pageHeight="842"
	columnWidth="515" leftMargin="40" rightMargin="40" topMargin="40"
	bottomMargin="40">
	<parameter name="servicesSubreport"
		class="net.sf.jasperreports.engine.JasperReport" />
	<field name="invoiceNumber" class="java.lang.String" />
	<field name="date" class="java.util.Date" />
	<field name="status" class="java.lang.String" />
	<field name="total" class="java.lang.Double" />
	<field name="customer"
		class="com.clear.balance.clearBalance.dto.customer.CustomerDto" />
	<field name="services" class="java.util.List" />
	<title>
		<band height="150">
			<staticText>
				<reportElement x="0" y="0" width="400" height="40"
					forecolor="#2C3E50" />
				<textElement>
					<font size="24" isBold="true" />
				</textElement>
				<text><![CDATA[CLEAR BALANCE]]></text>
			</staticText>
			<staticText>
				<reportElement x="350" y="0" width="100" height="20"
					forecolor="#7F8C8D" />
				<textElement>
					<font size="12" />
				</textElement>
				<text><![CDATA[Invoice Number]]></text>
			</staticText>
			<textField>
				<reportElement x="350" y="20" width="200" height="25"
					forecolor="#2C3E50" />
				<textElement>
					<font size="16" isBold="true" />
				</textElement>
				<textFieldExpression><![CDATA[$F{invoiceNumber}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="350" y="50" width="100" height="20"
					forecolor="#7F8C8D" />
				<textElement>
					<font size="12" />
				</textElement>
				<text><![CDATA[Date]]></text>
			</staticText>
			<textField>
				<reportElement x="350" y="70" width="200" height="25" />
				<textElement>
					<font size="14" />
				</textElement>
				<textFieldExpression><![CDATA[new java.text.SimpleDateFormat("dd/MM/yyyy").format($F{date})]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="350" y="100" width="100" height="20"
					forecolor="#7F8C8D" />
				<textElement>
					<font size="12" />
				</textElement>
				<text><![CDATA[Status]]></text>
			</staticText>
			<textField>
				<reportElement x="350" y="120" width="200" height="25" />
				<textElement>
					<font size="14" />
				</textElement>
				<textFieldExpression><![CDATA[$F{status}]]></textFieldExpression>
			</textField>
		</band>
	</title>
	<!-- ========================= --> <!-- CUSTOMER INFO --> <!-- ========================= -->
	<pageHeader>
		<band height="130">
			<staticText>
				<reportElement x="0" y="0" width="200" height="25"
					forecolor="#2C3E50" />
				<textElement>
					<font size="16" isBold="true" />
				</textElement>
				<text><![CDATA[Customer]]></text>
			</staticText>
			<rectangle>
				<reportElement x="0" y="30" width="515" height="80"
					backcolor="#F8F9FA" />
				<graphicElement>
					<pen lineWidth="0.5" lineColor="#ECF0F1" />
				</graphicElement>
			</rectangle>
			<textField>
				<reportElement x="20" y="40" width="300" height="20" />
				<textElement>
					<font size="14" isBold="true" />
				</textElement>
				<textFieldExpression><![CDATA[$F{customer}.getName()]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="20" y="65" width="300" height="20" />
				<textElement>
					<font size="12" />
				</textElement>
				<textFieldExpression><![CDATA["Address: " + $F{customer}.getAddress()]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="300" y="40" width="200" height="20" />
				<textElement>
					<font size="12" />
				</textElement>
				<textFieldExpression><![CDATA["Email: " + $F{customer}.getEmail()]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="300" y="65" width="200" height="20" />
				<textElement>
					<font size="12" />
				</textElement>
				<textFieldExpression><![CDATA["Phone: " + $F{customer}.getPhone()]]></textFieldExpression>
			</textField>
		</band>
	</pageHeader>
	<!-- ========================= --> <!-- SERVICE TABLE --> <!-- ========================= -->
	<columnHeader>
		<band height="40">
			<rectangle>
				<reportElement x="0" y="0" width="515" height="40"
					backcolor="#2C3E50" />
			</rectangle>
			<staticText>
				<reportElement x="15" y="0" width="185" height="40"
					forecolor="#FFFFFF" />
				<box>
					<topPen lineWidth="0.0" />
					<leftPen lineWidth="0.0" />
					<bottomPen lineWidth="0.5" lineColor="#ECF0F1" />
					<rightPen lineWidth="0.0" />
				</box>
				<textElement verticalAlignment="Middle">
					<font size="12" isBold="true" />
				</textElement>
				<text><![CDATA[Description]]></text>
			</staticText>
			<staticText>
				<reportElement x="200" y="0" width="100" height="40"
					forecolor="#FFFFFF" />
				<box>
					<topPen lineWidth="0.0" />
					<leftPen lineWidth="0.0" />
					<bottomPen lineWidth="0.5" lineColor="#ECF0F1" />
					<rightPen lineWidth="0.0" />
				</box>
				<textElement textAlignment="Center"
					verticalAlignment="Middle">
					<font size="12" isBold="true" />
				</textElement>
				<text><![CDATA[Rate]]></text>
			</staticText>
			<staticText>
				<reportElement x="280" y="0" width="90" height="40"
					forecolor="#FFFFFF" />
				<box>
					<topPen lineWidth="0.0" />
					<leftPen lineWidth="0.0" />
					<bottomPen lineWidth="0.5" lineColor="#ECF0F1" />
					<rightPen lineWidth="0.0" />
				</box>
				<textElement textAlignment="Right"
					verticalAlignment="Middle">
					<font size="12" isBold="true" />
				</textElement>
				<text><![CDATA[Price]]></text>
			</staticText>
			<staticText>
				<reportElement x="380" y="0" width="100" height="40"
					forecolor="#FFFFFF" />
				<box>
					<topPen lineWidth="0.0" />
					<leftPen lineWidth="0.0" />
					<bottomPen lineWidth="0.5" lineColor="#ECF0F1" />
					<rightPen lineWidth="0.0" />
				</box>
				<textElement textAlignment="Right"
					verticalAlignment="Middle">
					<font size="12" isBold="true" />
				</textElement>
				<text><![CDATA[Subtotal]]></text>
			</staticText>
		</band>
	</columnHeader>
	<!-- ========================= --> <!-- SERVICES --> <!-- ========================= -->
	<detail>
		<band height="30">
			<subreport>
				<reportElement x="0" y="0" width="515" height="30" />
				<dataSourceExpression> <![CDATA[new net.sf.jasperreports.engine.data.JRBeanCollectionDataSource($F{services})]]>
				</dataSourceExpression>
				<subreportExpression><![CDATA[$P{servicesSubreport}]]></subreportExpression>
			</subreport>
		</band>
	</detail>
	<summary>
		<band height="220"> <!-- Aumentado de 160 a 165 -->
			<line>
				<reportElement x="0" y="0" width="515" height="2" />
				<graphicElement>
					<pen lineWidth="2.0" lineColor="#ECF0F1" />
				</graphicElement>
			</line>

			<!-- Subtotal -->
			<staticText>
				<reportElement x="300" y="10" width="100" height="30" />
				<textElement textAlignment="Right">
					<font size="14" />
				</textElement>
				<text><![CDATA[Subtotal:]]></text>
			</staticText>
			<textField>
				<reportElement x="400" y="10" width="115" height="30" />
				<textElement textAlignment="Right">
					<font size="14" />
				</textElement>
				<textFieldExpression><![CDATA["€" + new java.text.DecimalFormat("#,##0.00").format($F{total})]]></textFieldExpression>
			</textField>

			<!-- Tax (5.4%) -->
			<staticText>
				<reportElement x="300" y="40" width="100" height="30" />
				<textElement textAlignment="Right">
					<font size="14" />
				</textElement>
				<text><![CDATA[Tax (5.4%):]]></text>
			</staticText>
			<textField>
				<reportElement x="400" y="40" width="115" height="30" />
				<textElement textAlignment="Right">
					<font size="14" />
				</textElement>
				<textFieldExpression>
                <![CDATA["€" + new java.text.DecimalFormat("#,##0.00").format($F{total} * 0.054)]]>
				</textFieldExpression>
			</textField>

			<!-- Total -->
			<staticText>
				<reportElement x="300" y="70" width="100" height="35" />
				<textElement textAlignment="Right">
					<font size="16" isBold="true" />
				</textElement>
				<text><![CDATA[Total:]]></text>
			</staticText>
			<textField>
				<reportElement x="400" y="70" width="115" height="35"
					forecolor="#2C3E50" />
				<textElement textAlignment="Right">
					<font size="18" isBold="true" />
				</textElement>
				<textFieldExpression>
                <![CDATA["€" + new java.text.DecimalFormat("#,##0.00").format($F{total} + ($F{total} * 0.054))]]>
				</textFieldExpression>
			</textField>

			<!-- Thank you message -->
			<staticText>
				<reportElement x="0" y="180" width="515" height="20"
					forecolor="#7F8C8D" />
				<textElement textAlignment="Center">
					<font size="10" />
				</textElement>
				<text><![CDATA[Thank you for trusting our services]]></text>
			</staticText>

			<!-- Footer -->
			<staticText>
				<reportElement x="0" y="200" width="515" height="15"
					forecolor="#95A5A6" /> <!-- Cambiado y=140 (antes 135) -->
				<textElement textAlignment="Center">
					<font size="9" />
				</textElement>
				<text><![CDATA[Clear Balance · billing@clearbalance.com · (123) 456-7890]]></text>
			</staticText>
		</band>
	</summary>
</jasperReport>