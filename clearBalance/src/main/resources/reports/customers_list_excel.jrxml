<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports 
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="customers_list_excel">
    
    <property name="net.sf.jasperreports.export.xls.detect.cell.type" value="true"/>
    <property name="net.sf.jasperreports.export.xls.remove.empty.space.between.columns" value="true"/>
    <property name="net.sf.jasperreports.export.xls.auto.fit.column" value="true"/>
    
    <!-- PARÁMETROS deben ir ANTES de los FIELDS -->
    <parameter name="REPORT_TITLE" class="java.lang.String"/>
    <parameter name="GENERATED_DATE" class="java.util.Date"/>
    
    <!-- FIELDS -->
    <field name="name" class="java.lang.String"/>
    <field name="email" class="java.lang.String"/>
    <field name="type" class="java.lang.String"/>
    <field name="status" class="java.lang.String"/>
    <field name="address" class="java.lang.String"/>
    <field name="phone" class="java.lang.String"/>
    <field name="createdAt" class="java.util.Date"/>
    <field name="totalInvoices" class="java.lang.Integer"/>
    <field name="totalAmount" class="java.lang.Double"/>
    
    <title>
        <band height="50"> <!-- Aumenté la altura de 40 a 50 -->
            <staticText>
                <reportElement x="0" y="0" width="842" height="20"/> <!-- Cambié y de 5 a 0 -->
                <textElement textAlignment="Center">
                    <font size="14" isBold="true"/>
                </textElement>
                <text><![CDATA[CUSTOMERS REPORT]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="20" width="842" height="15"/> <!-- Cambié y de 25 a 20, altura de 10 a 15 -->
                <textElement textAlignment="Center">
                    <font size="10"/> <!-- Aumenté de 8 a 10 -->
                </textElement>
                <textFieldExpression><![CDATA[$P{REPORT_TITLE}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="35" width="842" height="15"/> <!-- Cambié altura de 5 a 15 -->
                <textElement textAlignment="Center">
                    <font size="9"/> <!-- Aumenté de 6 a 9 -->
                </textElement>
                <textFieldExpression>
                    <![CDATA["Generated on: " + new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm:ss").format($P{GENERATED_DATE})]]>
                </textFieldExpression>
            </textField>
        </band>
    </title>
    
    <columnHeader>
        <band height="25">
            <staticText>
                <reportElement x="0" y="0" width="120" height="25" backcolor="#4F81BD"/>
                <textElement verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Customer Name]]></text>
            </staticText>
            <staticText>
                <reportElement x="120" y="0" width="140" height="25" backcolor="#4F81BD"/>
                <textElement verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Email]]></text>
            </staticText>
            <staticText>
                <reportElement x="260" y="0" width="80" height="25" backcolor="#4F81BD"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Type]]></text>
            </staticText>
            <staticText>
                <reportElement x="340" y="0" width="80" height="25" backcolor="#4F81BD"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Status]]></text>
            </staticText>
            <staticText>
                <reportElement x="420" y="0" width="100" height="25" backcolor="#4F81BD"/>
                <textElement verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Phone]]></text>
            </staticText>
            <staticText>
                <reportElement x="520" y="0" width="90" height="25" backcolor="#4F81BD"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Created]]></text>
            </staticText>
            <staticText>
                <reportElement x="610" y="0" width="70" height="25" backcolor="#4F81BD"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Invoices]]></text>
            </staticText>
            <staticText>
                <reportElement x="680" y="0" width="90" height="25" backcolor="#4F81BD"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Total Amount]]></text>
            </staticText>
        </band>
    </columnHeader>
    
    <detail>
        <band height="20">
            <textField>
                <reportElement x="0" y="0" width="120" height="20"/>
                <textElement verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{name}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="120" y="0" width="140" height="20"/>
                <textElement verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{email}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="260" y="0" width="80" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{type}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="340" y="0" width="80" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{status}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="420" y="0" width="100" height="20"/>
                <textElement verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{phone} != null ? $F{phone} : ""]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="520" y="0" width="90" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression>
                    <![CDATA[$F{createdAt} != null ? new java.text.SimpleDateFormat("dd/MM/yyyy").format($F{createdAt}) : ""]]>
                </textFieldExpression>
            </textField>
            <textField>
                <reportElement x="610" y="0" width="70" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{totalInvoices}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="680" y="0" width="90" height="20"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression>
                    <![CDATA["$" + new java.text.DecimalFormat("#,##0.00").format($F{totalAmount})]]>
                </textFieldExpression>
            </textField>
        </band>
    </detail>
    
    <summary>
        <band height="30">
            <staticText>
                <reportElement x="0" y="5" width="680" height="20"/>
                <textElement textAlignment="Right">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Total Customers:]]></text>
            </staticText>
            <textField>
                <reportElement x="680" y="5" width="70" height="20"/>
                <textElement textAlignment="Center">
                    <font size="9" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$V{REPORT_COUNT}]]></textFieldExpression>
            </textField>
        </band>
    </summary>
    
</jasperReport>